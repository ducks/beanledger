{
  "name": "beanledger",
  "version": "2026.08.04.1",
  "private": true,
  "type": "module",
  "scripts": {
    "migrate": "node scripts/migrate.js",
    "dev": "npm run migrate && vite dev",
    "build": "npm run migrate && vite build",
    "build:ci": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "e2e:server": "node scripts/migrate.js && vite dev --port 4173",
    "test:e2e": "node scripts/run-e2e.js",
    "test:e2e:ui": "node scripts/run-e2e.js --ui"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@sveltejs/adapter-node": "^5.5.7",
    "@sveltejs/kit": "^2.70.3",
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "@types/node": "^26.6.5",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@vitest/ui": "^4.1.12",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.7",
    "tslib": "^2.8.1",
    "typescript": "^5.9.3",
    "vite": "^7.3.7",
    "vitest": "^4.1.12"
  },
  "dependencies": {
    "nodemailer": "^10.1.7",
    "pg": "^8.23.1"
  }
}
